<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 18+ approvals removed approval_approver_user_create / _unlink_own.
        approval_ext defines equivalent rules (draft-only create/unlink for owners).
    -->

    <!-- Allow internal users to create approver lines (restricted by rules below) -->
    <record id="approvals.access_approval_approver" model="ir.model.access">
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="approval_ext_approver_user_create" model="ir.rule">
        <field name="name">Approval Approver: request owner create (draft)</field>
        <field name="model_id" ref="approvals.model_approval_approver"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
        <field name="domain_force">[
            ('request_id.request_owner_id', '=', user.id),
            ('request_id.request_status', '=', 'new'),
        ]</field>
    </record>

    <record id="approval_ext_approver_user_unlink_own" model="ir.rule">
        <field name="name">Approval Approver: request owner unlink (draft)</field>
        <field name="model_id" ref="approvals.model_approval_approver"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="1"/>
        <field name="domain_force">[
            '&amp;',
            '|',
            ('request_id.request_owner_id', '=', user.id),
            ('user_id', '=', user.id),
            ('request_id.request_status', '=', 'new'),
        ]</field>
    </record>

    <!-- Delete whole request only in draft (not editing or canceled) -->
    <record id="approvals.approval_request_unlink_request_owner_rule" model="ir.rule">
        <field name="domain_force">[
            ('request_owner_id', '=', user.id),
            ('request_status', '=', 'new'),
        ]</field>
    </record>
</odoo>
