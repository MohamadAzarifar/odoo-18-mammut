<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_category_view_form_product_categories" model="ir.ui.view">
        <field name="name">approval.category.form.type.access.ext</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approvals.approval_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']" position="after">
                <page string="Type Access" name="approval_ext_type_access">
                    <group string="Product categories">
                        <field name="approval_ext_product_category_ids"
                            widget="many2many_tags"
                            options="{'no_create_edit': True}"
                            placeholder="All products allowed when empty"/>
                    </group>
                    <group string="Department access">
                        <field name="department_ids"
                            widget="many2many_tags"
                            options="{'no_create_edit': True}"
                            placeholder="All departments when empty"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
