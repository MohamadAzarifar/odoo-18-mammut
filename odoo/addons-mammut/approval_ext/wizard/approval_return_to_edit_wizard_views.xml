<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_return_to_edit_wizard_view_form" model="ir.ui.view">
        <field name="name">approval.return.to.edit.wizard.form</field>
        <field name="model">approval.return.to.edit.wizard</field>
        <field name="arch" type="xml">
            <form string="Return for editing">
                <group class="fw-bold">
                    <field name="request_id" readonly="1"/>
                </group>
                <group>
                    <field name="reason" widget="text" placeholder="Describe what needs to be corrected..."
                        nolabel="1"/>
                </group>
                <footer>
                    <button name="action_apply" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Discard" data-hotkey="x" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
