<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="followup_record_graph_created" model="ir.ui.view">
        <field name="name">followup.record.graph.created</field>
        <field name="model">followup.record</field>
        <field name="arch" type="xml">
            <graph string="Follow-ups Over Time" type="bar" sample="1">
                <field name="create_date" interval="day"/>
                <field name="followup_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="followup_report_created_action" model="ir.actions.act_window">
        <field name="name">Follow-ups Over Time</field>
        <field name="res_model">followup.record</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="followup_record_graph_created"/>
        <field name="search_view_id" ref="followup_record_view_search_report"/>
    </record>
</odoo>
