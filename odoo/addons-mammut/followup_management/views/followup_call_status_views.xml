<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="followup_call_status_view_list" model="ir.ui.view">
        <field name="name">followup.call.status.list</field>
        <field name="model">followup.call.status</field>
        <field name="arch" type="xml">
            <list string="Call Statuses" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="followup_call_status_view_form" model="ir.ui.view">
        <field name="name">followup.call.status.form</field>
        <field name="model">followup.call.status</field>
        <field name="arch" type="xml">
            <form string="Call Status">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="followup_call_status_action" model="ir.actions.act_window">
        <field name="name">Call Statuses</field>
        <field name="res_model">followup.call.status</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
