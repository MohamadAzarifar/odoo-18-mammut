<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="followup_type_view_list" model="ir.ui.view">
        <field name="name">followup.type.list</field>
        <field name="model">followup.type</field>
        <field name="arch" type="xml">
            <list string="Follow-up Types">
                <field name="name"/>
                <field name="code"/>
                <field name="survey_template_id"
                    options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="followup_type_view_form" model="ir.ui.view">
        <field name="name">followup.type.form</field>
        <field name="model">followup.type</field>
        <field name="arch" type="xml">
            <form string="Follow-up Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="survey_template_id"
                                options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="followup_type_action" model="ir.actions.act_window">
        <field name="name">Follow-up Types</field>
        <field name="res_model">followup.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
