<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="followup_record_view_search" model="ir.ui.view">
        <field name="name">followup.record.search</field>
        <field name="model">followup.record</field>
        <field name="arch" type="xml">
            <search string="Follow Up Records">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="followup_type_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="dealer_name"/>
                <field name="dealer_code"/>
                <field name="vehicle_type"/>
                <field name="vin_chassis"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Answered" name="filter_answered" domain="[('status', '=', 'answered')]"/>
                <filter string="No Answer" name="filter_no_answer" domain="[('status', '=', 'no_answer')]"/>
                <filter string="Wrong Number" name="filter_wrong_number" domain="[('status', '=', 'wrong_number')]"/>
                <filter string="Not Cooperative" name="filter_not_cooperative" domain="[('status', '=', 'not_cooperative')]"/>
                <separator/>
                <filter string="Survey Completed" name="filter_survey_completed" domain="[('survey_completed', '=', True)]"/>
                <filter string="Survey Not Completed" name="filter_survey_not_completed" domain="[('survey_completed', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Follow-up Type" name="groupby_followup_type" context="{'group_by': 'followup_type_id'}"/>
                    <filter string="Status" name="groupby_status" context="{'group_by': 'status'}"/>
                    <filter string="Dealer Name" name="groupby_dealer_name" context="{'group_by': 'dealer_name'}"/>
                    <filter string="Vehicle Type" name="groupby_vehicle_type" context="{'group_by': 'vehicle_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="followup_record_view_list" model="ir.ui.view">
        <field name="name">followup.record.list</field>
        <field name="model">followup.record</field>
        <field name="arch" type="xml">
            <list string="Follow Up Records">
                <field name="name"/>
                <field name="followup_type_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                <field name="status" widget="badge"
                    decoration-info="status == 'draft'"
                    decoration-success="status == 'answered'"
                    decoration-warning="status == 'no_answer'"
                    decoration-danger="status in ('wrong_number', 'not_cooperative')"/>
                <field name="customer_name"/>
                <field name="dealer_name"/>
                <field name="vehicle_type"/>
                <field name="survey_completed"/>
                <field name="survey_score" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="followup_record_view_form" model="ir.ui.view">
        <field name="name">followup.record.form</field>
        <field name="model">followup.record</field>
        <field name="arch" type="xml">
            <form string="Follow Up Record">
                <header>
                    <button name="action_start_survey"
                        string="Start Survey"
                        type="object"
                        class="oe_highlight"
                        invisible="survey_user_input_id"/>
                    <button name="action_retire_survey"
                        string="Retire Survey"
                        type="object"
                        confirm="This will delete the current survey response and start a new one. Continue?"
                        invisible="not survey_user_input_id"/>
                    <button name="action_view_survey_answers"
                        string="View Survey Answers"
                        type="object"
                        class="oe_highlight"
                        invisible="not survey_completed"/>
                    <field name="status" widget="statusbar"
                        options="{'clickable': True}"
                        readonly="False"
                        statusbar_visible="draft,answered,no_answer,wrong_number,not_cooperative"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <field name="followup_type_code" invisible="1"/>
                    <field name="survey_user_input_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="followup_type_id"
                                readonly="survey_user_input_id"
                                options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="survey_completed" readonly="1"/>
                            <field name="survey_score" readonly="1"/>
                            <field name="survey_scoring_success" readonly="1"/>
                        </group>
                    </group>
                    <group string="Customer Information">
                        <group>
                            <field name="customer_name" readonly="survey_user_input_id"/>
                            <field name="customer_phone" readonly="survey_user_input_id"/>
                        </group>
                        <group>
                            <field name="customer_email" readonly="survey_user_input_id"/>
                            <field name="partner_id" readonly="1"
                                options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group string="Vehicle Information">
                        <group>
                            <field name="vin_chassis" readonly="survey_user_input_id"/>
                        </group>
                        <group>
                            <field name="vehicle_type" readonly="survey_user_input_id"/>
                        </group>
                    </group>
                    <group string="Dealer Information">
                        <group>
                            <field name="dealer_code" readonly="survey_user_input_id"/>
                            <field name="dealer_name" readonly="survey_user_input_id"/>
                        </group>
                        <group>
                            <field name="dealer_address" readonly="survey_user_input_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Call History" name="call_history">
                            <field name="call_history_ids">
                                <list editable="bottom">
                                    <field name="call_datetime"/>
                                    <field name="user_id"
                                        options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="call_status_id"
                                        options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Delivery" name="delivery"
                            invisible="followup_type_code != 'delivery'">
                            <group>
                                <group>
                                    <field name="vehicle_delivery_date"/>
                                    <field name="contract_vehicle_delivery_date"/>
                                </group>
                                <group>
                                    <field name="includes_participation_profit"/>
                                    <field name="includes_late_delivery_compensation"/>
                                </group>
                            </group>
                        </page>
                        <page string="On-site Service" name="onsite_service"
                            invisible="followup_type_code != 'onsite_service'">
                            <group>
                                <group>
                                    <field name="work_order_number"/>
                                    <field name="kilometer_number"/>
                                    <field name="reception_date"/>
                                    <field name="reception_time"/>
                                    <field name="release_time"/>
                                    <field name="warranty_status"/>
                                    <field name="vehicle_stop_duration_days"/>
                                </group>
                                <group>
                                    <field name="paid_cost_replaced_parts"/>
                                    <field name="service_labor_cost"/>
                                    <field name="standard_repair_time"/>
                                </group>
                            </group>
                            <group>
                                <field name="customer_statement"/>
                                <field name="used_parts_description"/>
                                <field name="services_provided_description"/>
                            </group>
                        </page>
                        <page string="Remote Service" name="remote_service"
                            invisible="followup_type_code != 'remote_service'">
                            <group>
                                <group>
                                    <field name="customer_call_time"/>
                                    <field name="average_arrival_time"/>
                                    <field name="arrival_time"/>
                                    <field name="repair_end_time"/>
                                </group>
                                <group>
                                    <field name="average_repair_time"/>
                                    <field name="average_return_time"/>
                                    <field name="customer_type"/>
                                </group>
                            </group>
                        </page>
                        <page string="Survey" name="survey">
                            <group>
                                <group>
                                    <field name="survey_user_input_id" readonly="1"
                                        options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="survey_completed" readonly="1"/>
                                </group>
                                <group>
                                    <field name="survey_score" readonly="1"/>
                                    <field name="survey_scoring_success" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="followup_record_action" model="ir.actions.act_window">
        <field name="name">Follow Up Records</field>
        <field name="res_model">followup.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="followup_record_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new follow-up record
            </p>
            <p>
                Track customer follow-ups, call history, and linked surveys.
            </p>
        </field>
    </record>
</odoo>
