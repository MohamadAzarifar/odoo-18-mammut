<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_approval_requests_estimated_cost" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage approval requests with estimated cost
            </p>
        </field>
    </record>

    <record id="action_approval_product_line_estimated_cost" model="ir.actions.act_window">
        <field name="name">Product Lines</field>
        <field name="res_model">approval.product.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage approval product lines
            </p>
        </field>
    </record>

    <menuitem
        id="menu_approvals_estimated_cost_root"
        name="Approvals Cost"
        sequence="5"
        web_icon="approvals_estimated_cost,static/description/icon.png"
        action="action_approval_requests_estimated_cost"
    />

    <menuitem
        id="menu_approvals_estimated_cost_requests"
        name="Approvals"
        parent="menu_approvals_estimated_cost_root"
        action="action_approval_requests_estimated_cost"
        sequence="10"
    />

    <menuitem
        id="menu_approvals_estimated_cost_lines"
        name="Product Lines"
        parent="menu_approvals_estimated_cost_root"
        action="action_approval_product_line_estimated_cost"
        sequence="20"
    />

</odoo>
