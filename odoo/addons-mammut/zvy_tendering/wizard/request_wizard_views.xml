<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">zvy.request.reject.wizard.form</field>
        <field name="model">zvy.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Purchase Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Explain why this request is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_request_return_wizard_form" model="ir.ui.view">
        <field name="name">zvy.request.return.wizard.form</field>
        <field name="model">zvy.request.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return for Correction">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Explain what needs to be corrected..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Return" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_request_assign_wizard_form" model="ir.ui.view">
        <field name="name">zvy.request.assign.wizard.form</field>
        <field name="model">zvy.request.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Commercial Experts">
                <group>
                    <field name="request_id" invisible="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="line_id" column_invisible="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="expert_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" string="Assign &amp; Start Inquiry" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_commission_assign_wizard_form" model="ir.ui.view">
        <field name="name">zvy.commission.assign.wizard.form</field>
        <field name="model">zvy.commission.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Commission Experts">
                <group>
                    <field name="case_id" invisible="1"/>
                    <field name="expert_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Assign Experts" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_request_quote_reject_wizard_form" model="ir.ui.view">
        <field name="name">zvy.request.quote.reject.wizard.form</field>
        <field name="model">zvy.request.quote.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Quotes">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Explain why these quotes are rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject Quotes" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_request_quote_shortfall_wizard_form" model="ir.ui.view">
        <field name="name">zvy.request.quote.shortfall.wizard.form</field>
        <field name="model">zvy.request.quote.shortfall.wizard</field>
        <field name="arch" type="xml">
            <form string="Fewer than 3 Valid Inquiries">
                <div class="alert alert-info" role="alert">
                    Fewer than 3 valid inquiries are recorded. Provide a reason to submit
                    this quote set to the Commercial Manager.
                </div>
                <group>
                    <field name="line_ids" invisible="1"/>
                    <field name="reason" placeholder="Explain why fewer than 3 valid inquiries are available..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Submit Quotes" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_request_award_not_lowest_wizard_form" model="ir.ui.view">
        <field name="name">zvy.request.award.not.lowest.wizard.form</field>
        <field name="model">zvy.request.award.not.lowest.wizard</field>
        <field name="arch" type="xml">
            <form string="Not the Lowest Price">
                <div class="alert alert-info" role="alert">
                    This quote is not the lowest unit price. Provide a reason
                    to award it.
                </div>
                <group>
                    <field name="quote_id" invisible="1"/>
                    <field name="reason" placeholder="Explain why this quote is awarded instead of a lower-priced offer..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Select as Awarded" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_request_split_wizard_form" model="ir.ui.view">
        <field name="name">zvy.request.split.wizard.form</field>
        <field name="model">zvy.request.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Split Purchase Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="note" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Split" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_request_create_po_wizard_form" model="ir.ui.view">
        <field name="name">zvy.request.create.po.wizard.form</field>
        <field name="model">zvy.request.create.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Purchase Order">
                <group>
                    <field name="request_id" invisible="1"/>
                </group>
                <p>Select the pending awarded lines to include. Unselected lines stay on the request until a later purchase order or reject.</p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="line_id" column_invisible="1"/>
                        <field name="selected"/>
                        <field name="product_id" readonly="1"/>
                        <field name="product_uom_qty" readonly="1"/>
                        <field name="product_uom_id" readonly="1"/>
                        <field name="awarded_partner_id" readonly="1"/>
                        <field name="price_unit" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" string="Create PO" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_ce_clarification_wizard_form" model="ir.ui.view">
        <field name="name">zvy.ce.clarification.wizard.form</field>
        <field name="model">zvy.ce.clarification.wizard</field>
        <field name="arch" type="xml">
            <form string="Post Clarification">
                <group>
                    <field name="envelope_id" invisible="1"/>
                    <field name="body" placeholder="Clarification for invited suppliers..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Post Clarification" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_zvy_meeting_transfer_wizard_form" model="ir.ui.view">
        <field name="name">zvy.meeting.transfer.wizard.form</field>
        <field name="model">zvy.meeting.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer to Another Meeting">
                <group>
                    <field name="meeting_case_id" invisible="1"/>
                    <field name="source_meeting_id" readonly="1"/>
                    <field name="requesting_company_id" invisible="1"/>
                    <field name="target_meeting_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Transfer" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
