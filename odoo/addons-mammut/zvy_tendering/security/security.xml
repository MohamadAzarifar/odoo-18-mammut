        <!-- Planner: own PRs only -->
        <record id="rule_zvy_purchase_request_planner_own" model="ir.rule">
            <field name="name">Purchase Request: planner own</field>
            <field name="model_id" ref="model_zvy_purchase_request"/>
            <field name="groups" eval="[(4, ref('group_zvy_planner'))]"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
