            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- CCE: assigned lines / related PRs only -->
        <record id="rule_zvy_purchase_request_cce_all" model="ir.rule">
            <field name="name">Purchase Request: commercial expert assigned</field>
            <field name="model_id" ref="model_zvy_purchase_request"/>
            <field name="groups" eval="[(4, ref('group_zvy_commercial_expert'))]"/>
            <field name="domain_force">[('line_ids.expert_user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="1"/>
