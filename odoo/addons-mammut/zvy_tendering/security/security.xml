            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- CM: all company PRs (company scope via multi-company rule) -->
        <record id="rule_zvy_purchase_request_cm_all" model="ir.rule">
