<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_quote_list" model="ir.ui.view">
        <field name="name">zvy.quote.list</field>
        <field name="model">zvy.quote</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_id"/>
                <field name="line_id" column_invisible="context.get('zvy_quote_from_line')"/>
                <field name="allowed_partner_ids" column_invisible="1"/>
                <field name="partner_id" options="{'no_create': True}"/>
                <field name="contact_name"/>
                <field name="contact_phone"/>
                <field name="no_price_obtained"/>
                <field name="price_unit" readonly="no_price_obtained"/>
                <field name="comments" optional="show"/>
                <field name="product_uom_qty" optional="hide"/>
                <field name="amount_total"/>
                <field name="received_date" optional="show"/>
                <field name="is_valid_inquiry" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="expert_user_id"/>
                <field name="state" widget="badge"/>
                <field name="is_awarded" column_invisible="1"/>
                <field name="request_state" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_select_as_awarded" type="object"
                        string="Select as Awarded"
                        icon="fa-trophy"
                        class="btn-link"
                        invisible="request_state != 'quote_review' or state not in ('submitted', 'rejected') or is_awarded"
                        context="{'zvy_ui_award': True}"
                        groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_quote_form" model="ir.ui.view">
        <field name="name">zvy.quote.form</field>
        <field name="model">zvy.quote</field>
        <field name="arch" type="xml">
            <form string="Inquiry Quote">
                <header>
                    <field name="state" widget="statusbar"
                            statusbar_visible="draft,submitted,accepted,rejected"
                            readonly="1"/>
                </header>
                <sheet>
                    <field name="request_state" invisible="1"/>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"/>
                            <field name="line_id" readonly="request_state != 'inquiry'"/>
                            <field name="allowed_partner_ids" invisible="1"/>
                            <field name="partner_id" readonly="request_state != 'inquiry'"
                                    options="{'no_create': True}"/>
                            <field name="contact_name" readonly="request_state != 'inquiry'"/>
                            <field name="contact_phone" readonly="request_state != 'inquiry'"/>
                            <field name="expert_user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="no_price_obtained" readonly="request_state != 'inquiry'"/>
                            <field name="price_unit"
                                    readonly="request_state != 'inquiry' or no_price_obtained"/>
                            <field name="product_uom_qty"/>
                            <field name="amount_total"/>
                            <field name="received_date" readonly="request_state != 'inquiry'"/>
                            <field name="is_valid_inquiry"/>
                            <field name="tolerance_percent"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commercial Terms" name="terms">
                            <group>
                                <group>
                                    <field name="comments" readonly="request_state != 'inquiry'"/>
                                    <field name="delivery_date" readonly="request_state != 'inquiry'"/>
                                    <field name="advance_percent" readonly="request_state != 'inquiry'"/>
                                    <field name="payment_type" readonly="request_state != 'inquiry'"/>
                                    <field name="discount_percent" readonly="request_state != 'inquiry'"/>
                                </group>
                                <group>
                                    <field name="shipping" readonly="request_state != 'inquiry'"/>
                                    <field name="packaging_type" readonly="request_state != 'inquiry'"/>
                                    <field name="packaging_count" readonly="request_state != 'inquiry'"/>
                                    <field name="contract_ref" readonly="request_state != 'inquiry'"/>
                                    <field name="nikan_amount" readonly="request_state != 'inquiry'"/>
                                    <field name="price_adjustment" readonly="request_state != 'inquiry'"/>
                                    <field name="warranty" readonly="request_state != 'inquiry'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Attachments" name="attachments">
                            <group>
                                <field name="proforma" filename="proforma_filename"
                                        readonly="request_state != 'inquiry'"/>
                                <field name="proforma_filename" invisible="1"/>
                            </group>
                            <field name="attachment_ids" widget="many2many_binary"
                                    readonly="request_state != 'inquiry'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
