<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_quote_list" model="ir.ui.view">
        <field name="name">zvy.quote.list</field>
        <field name="model">zvy.quote</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_id"/>
                <field name="line_id"/>
                <field name="partner_id"/>
                <field name="price_unit"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="expert_user_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_quote_form" model="ir.ui.view">
        <field name="name">zvy.quote.form</field>
        <field name="model">zvy.quote</field>
        <field name="arch" type="xml">
            <form string="Inquiry Quote">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,accepted,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"/>
                            <field name="line_id"/>
                            <field name="partner_id"/>
                            <field name="expert_user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="price_unit"/>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zvy_commission_case_list" model="ir.ui.view">
        <field name="name">zvy.commission.case.list</field>
        <field name="model">zvy.commission.case</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_id"/>
                <field name="reason_high_value"/>
                <field name="reason_commission_item"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_commission_case_form" model="ir.ui.view">
        <field name="name">zvy.commission.case.form</field>
        <field name="model">zvy.commission.case</field>
        <field name="arch" type="xml">
            <form string="Commission Case">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="reason_high_value"/>
                            <field name="reason_commission_item"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
