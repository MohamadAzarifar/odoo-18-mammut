<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_request_list" model="ir.ui.view">
        <field name="name">zvy.purchase.request.list</field>
        <field name="model">zvy.purchase.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="purchase_level" optional="show"/>
                <field name="purchase_nature" optional="hide"/>
                <field name="is_formalities" optional="hide"/>
                <field name="state" widget="badge"
                        decoration-info="state in ('submitted', 'inquiry', 'quote_review')"
                        decoration-warning="state in ('correction', 'cm_review', 'signatory')"
                        decoration-danger="state == 'rejected'"
                        decoration-success="state in ('commission', 'po_ready', 'done')"
                        decoration-muted="state == 'draft'"/>
                <field name="is_high_value" optional="hide"/>
                <field name="procurement_type" optional="show"/>
                <field name="is_commission_item" optional="hide"/>
                <field name="has_sole_source" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_purchase_request_form" model="ir.ui.view">
        <field name="name">zvy.purchase.request.form</field>
        <field name="model">zvy.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'correction')"
                            context="{'zvy_ui_submit': True}"
                            groups="zvy_tendering.group_zvy_planner,zvy_tendering.group_zvy_tendering_admin"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('submitted', 'cm_review', 'po_ready')"
                            groups="zvy_tendering.group_zvy_commercial_manager"/>
                    <button name="action_return_correction" string="Return for Correction" type="object"
                            invisible="state not in ('submitted', 'cm_review')"
                            groups="zvy_tendering.group_zvy_commercial_manager"/>
                    <button name="action_assign_experts" string="Assign Experts" type="object"
                            class="btn-primary"
                            invisible="state not in ('submitted', 'cm_review', 'inquiry')"
                            groups="zvy_tendering.group_zvy_commercial_manager"/>
                    <button name="action_submit_quotes" string="Submit Quotes" type="object"
                            class="btn-primary"
                            invisible="state != 'inquiry' or procurement_type != 'enquiry'"
                            context="{'zvy_ui_submit': True}"
                            groups="zvy_tendering.group_zvy_commercial_expert"/>
                    <button name="action_approve_quotes" string="Approve Quotes" type="object"
                            class="btn-primary"
                            invisible="state != 'quote_review'"
                            groups="zvy_tendering.group_zvy_commercial_manager"/>
                    <button name="action_reject_quotes" string="Reject Quotes" type="object"
                            invisible="state != 'quote_review'"
                            groups="zvy_tendering.group_zvy_commercial_manager"/>
                    <button name="action_create_closed_envelope" string="Closed Envelope" type="object"
                            invisible="procurement_type != 'tendering' or (state != 'inquiry' and not has_ce_retender)"
                            groups="zvy_tendering.group_zvy_commercial_expert,zvy_tendering.group_zvy_commercial_manager"/>
                    <button name="action_resubmit_signatory" string="Resubmit to Signatories" type="object"
                            class="btn-primary"
                            invisible="state != 'cm_review' or not approval_request_id"
                            groups="zvy_tendering.group_zvy_commercial_manager"/>
                    <button name="action_create_po" string="Create PO" type="object"
                            class="btn-primary"
                            invisible="state != 'po_ready'"
                            context="{'zvy_ui_create_po': True}"
                            groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_commission_manager"/>
                    <field name="state" widget="statusbar"
                            statusbar_visible="draft,submitted,cm_review,inquiry,quote_review,commission,signatory,po_ready,done,correction,rejected"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_mixed_procurement or state not in ('draft', 'correction')">
                        This request mixes Enquiry and Tendering products.
                        Submit will ask you to split it into two purchase requests.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'quote_review' or procurement_type == 'tendering'"
                         groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin">
                        Use <b>Select as Awarded</b> on each line’s winning quote
                        (or set <b>Awarded Quote</b>), then click <b>Approve Quotes</b>
                        (or <b>Reject Quotes</b>) in the header. Awarding a quote
                        that is not the lowest price requires a written reason.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_approval_request" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="approval_request_count == 0"
                                groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin">
                            <field name="approval_request_count" widget="statinfo" string="Signatory"/>
                        </button>
                        <button name="action_open_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-credit-card"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="POs"/>
                        </button>
                        <button name="action_open_split_request" type="object"
                                class="oe_stat_button" icon="fa-files-o"
                                invisible="not split_request_id and not split_from_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Split PR</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id"/>
                            <field name="description" readonly="state not in ('draft', 'correction')"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                     readonly="state not in ('draft', 'correction')"/>
                            <field name="currency_id" readonly="state not in ('draft', 'correction')"/>
                            <field name="amount_total"/>
                            <field name="amount_for_level"/>
                            <field name="purchase_nature" readonly="state not in ('draft', 'correction', 'signatory')"/>
                            <field name="purchase_level"/>
                            <field name="is_formalities"/>
                            <field name="approval_request_id" invisible="1"/>
                            <field name="split_request_id" invisible="1"/>
                            <field name="split_from_id" invisible="1"/>
                            <field name="parent_request_id" invisible="1"/>
                            <field name="procurement_type"/>
                            <field name="is_mixed_procurement" invisible="not is_mixed_procurement"/>
                            <field name="is_high_value"/>
                            <field name="is_commission_item" readonly="1"/>
                            <field name="has_sole_source" readonly="1"/>
                            <field name="commission_case_id" invisible="not commission_case_id"/>
                            <field name="commission_require_comparison" invisible="1"/>
                            <field name="commission_require_technical" invisible="1"/>
                            <field name="closed_envelope_id" invisible="not closed_envelope_id"/>
                            <field name="has_ce_retender" invisible="1"/>
                            <field name="award_partner_id" invisible="not award_partner_id"/>
                        </group>
                    </group>
                    <group invisible="not reject_reason">
                        <field name="reject_reason" readonly="1"/>
                    </group>
                    <group invisible="not return_reason">
                        <field name="return_reason" readonly="1"/>
                    </group>
                    <group invisible="not quote_reject_reason">
                        <field name="quote_reject_reason" readonly="1"/>
                    </group>
                    <group string="Commission Dossier"
                           invisible="not commission_require_comparison and not commission_require_technical">
                        <field name="commission_comparison_attachment_ids" widget="many2many_binary"
                               invisible="not commission_require_comparison"/>
                        <field name="commission_technical_attachment_ids" widget="many2many_binary"
                               invisible="not commission_require_technical"/>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'correction', 'quote_review', 'signatory')">
                                <list editable="bottom">
                                    <field name="product_id" readonly="parent.state not in ('draft', 'correction', 'signatory')"/>
                                    <field name="procurement_type" optional="show"/>
                                    <field name="product_uom_qty" readonly="parent.state not in ('draft', 'correction', 'signatory')"/>
                                    <field name="product_uom_id" readonly="parent.state not in ('draft', 'correction', 'signatory')"/>
                                    <field name="price_estimate" readonly="parent.state not in ('draft', 'correction', 'signatory')"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="price_subtotal"/>
                                    <field name="sole_source" readonly="1"/>
                                    <field name="is_commission_item" readonly="1"/>
                                    <field name="expert_user_ids" widget="many2many_tags" readonly="1" optional="show"/>
                                    <field name="quote_count" optional="show"/>
                                    <button name="action_view_quotes" type="object" string="Quotes"
                                            icon="fa-list" class="btn-link"
                                            invisible="procurement_type != 'enquiry'"/>
                                    <field name="quotes_submitted" optional="show"/>
                                    <field name="quote_shortfall_reason" optional="hide"/>
                                    <field name="award_not_lowest_reason" optional="hide"/>
                                    <field name="awarded_quote_id"
                                              domain="[('line_id', '=', id), ('state', 'in', ('submitted', 'accepted'))]"
                                              readonly="parent.state not in ('quote_review', 'signatory')"
                                              options="{'no_create': True, 'no_create_edit': True}"
                                              groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin,zvy_tendering.group_zvy_signatory"/>
                                    <field name="awarded_partner_id" optional="hide" readonly="1"/>
                                    <field name="ce_retender" optional="hide" readonly="1"/>
                                    <field name="purchase_state" optional="show" readonly="1"
                                              widget="badge"
                                              decoration-info="purchase_state == 'pending'"
                                              decoration-success="purchase_state == 'ordered'"
                                              decoration-muted="purchase_state == 'cancelled'"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="procurement_type"/>
                                            <field name="product_uom_qty"/>
                                            <field name="product_uom_id"/>
                                            <field name="price_estimate"/>
                                            <field name="price_subtotal"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                        <group>
                                            <field name="sole_source" readonly="1"/>
                                            <field name="is_commission_item" readonly="1"/>
                                            <field name="expert_user_ids" widget="many2many_tags" readonly="1"/>
                                            <field name="awarded_quote_id"
                                                      domain="[('line_id', '=', id), ('state', 'in', ('submitted', 'accepted'))]"
                                                      readonly="request_state != 'quote_review'"
                                                      options="{'no_create': True, 'no_create_edit': True}"
                                                      groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin,zvy_tendering.group_zvy_signatory"/>
                                            <field name="awarded_partner_id" readonly="1"/>
                                            <field name="ce_retender" readonly="1"/>
                                            <field name="quote_shortfall_reason" readonly="1"
                                                   invisible="not quote_shortfall_reason"/>
                                            <field name="award_not_lowest_reason"
                                                      readonly="request_state != 'quote_review'"
                                                      groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin,zvy_tendering.group_zvy_signatory"/>
                                            <field name="last_vendor_id" readonly="1"/>
                                            <field name="last_price" readonly="1"/>
                                            <field name="last_purchase_date" readonly="1"/>
                                            <field name="purchase_state" readonly="1"/>
                                            <field name="request_state" invisible="1"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page string="Quotes" name="line_quotes"
                                              invisible="procurement_type != 'enquiry'">
                                            <field name="quote_ids" readonly="request_state != 'inquiry'">
                                                <list editable="bottom">
                                                    <field name="allowed_partner_ids" column_invisible="1"/>
                                                    <field name="partner_id" options="{'no_create': True}"/>
                                                    <field name="contact_name" optional="hide"/>
                                                    <field name="contact_phone" optional="hide"/>
                                                    <field name="price_unit"/>
                                                    <field name="amount_total"/>
                                                    <field name="received_date" optional="hide"/>
                                                    <field name="is_valid_inquiry" optional="hide"/>
                                                    <field name="currency_id" column_invisible="1"/>
                                                    <field name="expert_user_id" readonly="1"/>
                                                    <field name="state" readonly="1"/>
                                                    <field name="is_awarded" column_invisible="1"/>
                                                    <field name="request_state" column_invisible="1"/>
                                                    <field name="request_id" column_invisible="1"/>
                                                    <button name="action_select_as_awarded" type="object"
                                                            string="Select as Awarded"
                                                            icon="fa-trophy"
                                                            class="btn-link"
                                                            invisible="request_state != 'quote_review' or state not in ('submitted', 'rejected') or is_awarded"
                                                            context="{'zvy_ui_award': True}"
                                                            groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin"/>
                                                </list>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zvy_purchase_request_search" model="ir.ui.view">
        <field name="name">zvy.purchase.request.search</field>
        <field name="model">zvy.purchase.request</field>
        <field name="arch" type="xml">
            <search string="Purchase Requests">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="description"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="My Requests" name="my_requests"
                        domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="CM Review" name="cm_review" domain="[('state', '=', 'cm_review')]"/>
                <filter string="Awaiting Review" name="awaiting_review"
                        domain="[('state', 'in', ('submitted', 'cm_review'))]"/>
                <filter string="Inquiry" name="inquiry" domain="[('state', '=', 'inquiry')]"/>
                <filter string="Quote Review" name="quote_review" domain="[('state', '=', 'quote_review')]"/>
                <filter string="Correction" name="correction" domain="[('state', '=', 'correction')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="High Value" name="high_value" domain="[('is_high_value', '=', True)]"/>
                <filter string="Formalities" name="formalities" domain="[('is_formalities', '=', True)]"/>
                <filter string="Commission Item" name="commission_item" domain="[('is_commission_item', '=', True)]"/>
                <filter string="Enquiry" name="enquiry" domain="[('procurement_type', '=', 'enquiry')]"/>
                <filter string="Tendering" name="tendering" domain="[('procurement_type', '=', 'tendering')]"/>
                <separator/>
                <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Purchase Level" name="group_purchase_level" context="{'group_by': 'purchase_level'}"/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_zvy_purchase_request_line_list" model="ir.ui.view">
        <field name="name">zvy.purchase.request.line.list</field>
        <field name="model">zvy.purchase.request.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_id"/>
                <field name="product_id"/>
                <field name="procurement_type" optional="show"/>
                <field name="product_uom_qty"/>
                <field name="product_uom_id"/>
                <field name="price_estimate"/>
                <field name="price_subtotal"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sole_source"/>
                <field name="expert_user_ids" widget="many2many_tags"/>
                <field name="quote_count"/>
                <button name="action_view_quotes" type="object" string="Quotes"
                        icon="fa-list" class="btn-link"
                        invisible="procurement_type != 'enquiry'"/>
                <field name="quote_shortfall_reason" optional="hide"/>
                <field name="purchase_state" optional="show" widget="badge"/>
                <field name="request_state" column_invisible="1"/>
                <field name="quotes_submitted" widget="boolean_toggle" readonly="1"/>
                <button name="action_submit_quotes" type="object" string="Submit Quotes"
                        icon="fa-paper-plane" class="btn-link"
                        invisible="quotes_submitted or request_state != 'inquiry' or procurement_type != 'enquiry'"
                        context="{'zvy_ui_submit': True}"
                        groups="zvy_tendering.group_zvy_commercial_expert"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_purchase_request_line_form" model="ir.ui.view">
        <field name="name">zvy.purchase.request.line.form</field>
        <field name="model">zvy.purchase.request.line</field>
        <field name="arch" type="xml">
            <form string="Purchase Request Line">
                <header>
                    <button name="action_submit_quotes" string="Submit Quotes" type="object"
                            class="btn-primary"
                            invisible="request_state != 'inquiry' or quotes_submitted or procurement_type != 'enquiry'"
                            context="{'zvy_ui_submit': True}"
                            groups="zvy_tendering.group_zvy_commercial_expert"/>
                    <field name="quotes_submitted" invisible="1"/>
                </header>
                <sheet>
                    <field name="request_state" invisible="1"/>
                    <widget name="web_ribbon" title="Quotes Submitted" bg_color="text-bg-success"
                            invisible="not quotes_submitted"/>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"/>
                            <field name="product_id"
                                    readonly="request_state not in ('draft', 'correction', 'signatory')"/>
                            <field name="procurement_type"/>
                            <field name="product_uom_qty"
                                    readonly="request_state not in ('draft', 'correction', 'signatory')"/>
                            <field name="product_uom_id"
                                    readonly="request_state not in ('draft', 'correction', 'signatory')"/>
                            <field name="price_estimate"
                                    readonly="request_state not in ('draft', 'correction', 'signatory')"/>
                            <field name="price_subtotal"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="sole_source" readonly="1"/>
                            <field name="is_commission_item" readonly="1"/>
                            <field name="expert_user_ids" widget="many2many_tags" readonly="1"/>
                            <field name="awarded_quote_id"
                                    domain="[('line_id', '=', id), ('state', 'in', ('submitted', 'accepted'))]"
                                    readonly="request_state not in ('quote_review', 'signatory')"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin,zvy_tendering.group_zvy_signatory"/>
                            <field name="quote_shortfall_reason" readonly="1"
                                   invisible="not quote_shortfall_reason"/>
                            <field name="award_not_lowest_reason"
                                    readonly="request_state != 'quote_review'"
                                    groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin,zvy_tendering.group_zvy_signatory"/>
                            <field name="last_vendor_id" readonly="1"/>
                            <field name="last_price" readonly="1"/>
                            <field name="last_purchase_date" readonly="1"/>
                            <field name="purchase_state" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quotes" name="quotes"
                              invisible="procurement_type != 'enquiry'">
                            <field name="quote_ids" readonly="request_state != 'inquiry'">
                                <list editable="bottom">
                                    <field name="allowed_partner_ids" column_invisible="1"/>
                                    <field name="partner_id" options="{'no_create': True}"/>
                                    <field name="contact_name" optional="hide"/>
                                    <field name="contact_phone" optional="hide"/>
                                    <field name="price_unit"/>
                                    <field name="amount_total"/>
                                    <field name="received_date" optional="show"/>
                                    <field name="is_valid_inquiry" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="expert_user_id" readonly="1"/>
                                    <field name="state" readonly="1"/>
                                    <field name="is_awarded" column_invisible="1"/>
                                    <field name="request_state" column_invisible="1"/>
                                    <field name="request_id" column_invisible="1"/>
                                    <button name="action_select_as_awarded" type="object"
                                            string="Select as Awarded"
                                            icon="fa-trophy"
                                            class="btn-link"
                                            invisible="request_state != 'quote_review' or state not in ('submitted', 'rejected') or is_awarded"
                                            context="{'zvy_ui_award': True}"
                                            groups="zvy_tendering.group_zvy_commercial_manager,zvy_tendering.group_zvy_tendering_admin"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zvy_purchase_request_line_search" model="ir.ui.view">
        <field name="name">zvy.purchase.request.line.search</field>
        <field name="model">zvy.purchase.request.line</field>
        <field name="arch" type="xml">
            <search string="Request Lines">
                <field name="request_id"/>
                <field name="product_id"/>
                <field name="expert_user_ids"/>
                <filter string="My Assignments" name="my_assignments"
                        domain="[('expert_user_ids', 'in', [uid])]"/>
                <filter string="In Inquiry" name="in_inquiry"
                        domain="[('request_id.state', '=', 'inquiry')]"/>
                <filter string="Quote Review" name="in_quote_review"
                        domain="[('request_id.state', '=', 'quote_review')]"/>
            </search>
        </field>
    </record>

    <record id="action_zvy_purchase_request" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">zvy.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zvy_purchase_request_search"/>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a purchase request
            </p>
            <p>
                Planners draft and submit requests; Commercial Managers review,
                assign experts, and approve quote sets.
            </p>
        </field>
    </record>

    <record id="action_zvy_purchase_request_cm_queue" model="ir.actions.act_window">
        <field name="name">Awaiting Review</field>
        <field name="res_model">zvy.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zvy_purchase_request_search"/>
        <field name="domain">[('state', 'in', ('submitted', 'cm_review'))]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No purchase requests awaiting review
            </p>
            <p>
                New and CM-review purchase requests appear here for Commercial Managers.
            </p>
        </field>
    </record>

    <record id="action_zvy_purchase_request_quote_review" model="ir.actions.act_window">
        <field name="name">Quote Review</field>
        <field name="res_model">zvy.purchase.request</field>
        <field name="view_mode">list,form</field>
