<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Commission Case -->
    <record id="view_zvy_commission_case_list" model="ir.ui.view">
        <field name="name">zvy.commission.case.list</field>
        <field name="model">zvy.commission.case</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_id"/>
                <field name="reason_high_value"/>
                <field name="reason_commission_item"/>
                <field name="expert_user_ids" widget="many2many_tags" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_commission_case_form" model="ir.ui.view">
        <field name="name">zvy.commission.case.form</field>
        <field name="model">zvy.commission.case</field>
        <field name="arch" type="xml">
            <form string="Commission Case">
                <header>
                    <button name="action_assign_experts" string="Assign Experts" type="object"
                            class="btn-primary"
                            invisible="state not in ('open', 'in_review', 'meeting')"
                            groups="zvy_tendering.group_zvy_commission_manager"/>
                    <button name="action_approve_without_meeting" string="Approve Without Meeting" type="object"
                            class="btn-primary"
                            invisible="state not in ('open', 'in_review', 'meeting')"
                            groups="zvy_tendering.group_zvy_commission_manager"/>
                    <button name="action_manager_approve" string="Approve" type="object"
                            invisible="state not in ('in_review', 'meeting')"
                            groups="zvy_tendering.group_zvy_commission_manager"/>
                    <button name="action_manager_corrections" string="Request Corrections" type="object"
                            invisible="state not in ('in_review', 'meeting')"
                            groups="zvy_tendering.group_zvy_commission_manager"/>
                    <button name="action_manager_reject" string="Reject" type="object"
                            invisible="state not in ('open', 'in_review', 'meeting')"
                            groups="zvy_tendering.group_zvy_commission_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,in_review,meeting,approved,corrections,returned,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"
                                      options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="meeting_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reason_high_value"/>
                            <field name="reason_commission_item"/>
                            <field name="manager_decision" readonly="1"/>
                            <field name="manager_notes"
                                      readonly="state in ('approved', 'rejected', 'corrections', 'returned')"/>
                            <field name="precheck_failed" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="expert_user_ids" widget="many2many_tags"
                                  readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Validation Report" name="validation_report">
                            <field name="precheck_ids" readonly="1">
                                <list>
                                    <field name="sequence" string="Check"/>
                                    <field name="name"/>
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'pass'"
                                           decoration-danger="result == 'fail'"
                                           decoration-info="result == 'skipped'"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reviews" name="reviews">
                            <field name="review_ids">
                                <list>
                                    <field name="expert_user_id"/>
                                    <field name="recommendation"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Meeting History" name="meeting_history">
                            <field name="meeting_case_ids" readonly="1">
                                <list>
                                    <field name="meeting_id"/>
                                    <field name="review_status" widget="badge"/>
                                    <field name="decision"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zvy_commission_case_search" model="ir.ui.view">
        <field name="name">zvy.commission.case.search</field>
        <field name="model">zvy.commission.case</field>
        <field name="arch" type="xml">
            <search string="Commission Cases">
                <field name="name"/>
                <field name="request_id"/>
                <field name="expert_user_ids"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="In Review" name="in_review" domain="[('state', '=', 'in_review')]"/>
                <filter string="Meeting" name="meeting" domain="[('state', '=', 'meeting')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <filter string="My Assignments" name="my_assignments"
                        domain="[('expert_user_ids', 'in', [uid])]"/>
                <separator/>
                <filter string="High Value" name="high_value" domain="[('reason_high_value', '=', True)]"/>
                <filter string="Commission Item" name="commission_item"
                        domain="[('reason_commission_item', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_zvy_commission_case" model="ir.actions.act_window">
        <field name="name">Commission Cases</field>
        <field name="res_model">zvy.commission.case</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zvy_commission_case_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commission cases yet.
            </p>
            <p>Cases are created for Need Commission or large PRs. Enquiry PRs open a case after company signatures; tendering PRs open a case after quote approval.</p>
        </field>
    </record>

    <record id="action_zvy_commission_case_my" model="ir.actions.act_window">
        <field name="name">My Assignments</field>
        <field name="res_model">zvy.commission.case</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zvy_commission_case_search"/>
        <field name="domain">[('expert_user_ids', 'in', [uid])]</field>
        <field name="context">{'search_default_my_assignments': 1}</field>
    </record>

    <!-- Commission Review -->
    <record id="view_zvy_commission_review_list" model="ir.ui.view">
        <field name="name">zvy.commission.review.list</field>
        <field name="model">zvy.commission.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="case_id"/>
                <field name="expert_user_id"/>
                <field name="recommendation"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_commission_review_form" model="ir.ui.view">
        <field name="name">zvy.commission.review.form</field>
        <field name="model">zvy.commission.review</field>
        <field name="arch" type="xml">
            <form string="Commission Review">
                <header>
                    <button name="action_submit" string="Submit Review" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="zvy_tendering.group_zvy_commission_expert,zvy_tendering.group_zvy_tendering_admin"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="case_id" readonly="1"/>
                            <field name="expert_user_id" readonly="1"/>
                            <field name="recommendation" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Audit Notes">
                        <field name="notes_accuracy" readonly="state != 'draft'"/>
                        <field name="notes_policy" readonly="state != 'draft'"/>
                        <field name="notes_suppliers" readonly="state != 'draft'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zvy_commission_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">zvy.commission.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('expert_user_id', '=', uid)]</field>
    </record>

    <!-- Commission Meeting -->
    <record id="view_zvy_commission_meeting_list" model="ir.ui.view">
        <field name="name">zvy.commission.meeting.list</field>
        <field name="model">zvy.commission.meeting</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="datetime"/>
                <field name="state" widget="badge"/>
                <field name="requesting_company_id" groups="base.group_multi_company"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="location" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_commission_meeting_form" model="ir.ui.view">
        <field name="name">zvy.commission.meeting.form</field>
        <field name="model">zvy.commission.meeting</field>
        <field name="arch" type="xml">
            <form string="Commission Meeting">
                <header>
                    <button name="action_mark_held" string="Mark Held" type="object"
                            class="btn-primary"
                            invisible="state != 'scheduled'"
                            groups="zvy_tendering.group_zvy_commission_manager"/>
                    <button name="action_mark_signed" string="Mark Signed" type="object"
                            invisible="state != 'held'"
                            groups="zvy_tendering.group_zvy_commission_manager"/>
                    <button name="action_cancel" string="Cancel Meeting" type="object"
                            invisible="state not in ('scheduled', 'held')"
                            groups="zvy_tendering.group_zvy_commission_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="scheduled,held,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state in ('signed', 'cancelled')"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="datetime" readonly="state in ('signed', 'cancelled')"/>
                            <field name="location" readonly="state in ('signed', 'cancelled')"/>
                            <field name="requesting_company_id"
                                   readonly="state != 'scheduled' or meeting_case_ids"
                                   options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="minutes_attachment_id"
                                   readonly="state in ('signed', 'cancelled')"/>
                            <field name="notes" readonly="state in ('signed', 'cancelled')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agenda" name="agenda">
                            <field name="meeting_case_ids"
                                   readonly="state in ('signed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="case_id" options="{'no_create': True}"/>
                                    <field name="request_id"/>
                                    <field name="review_status" widget="badge" optional="show"/>
                                    <field name="decision"/>
                                    <button name="action_transfer" type="object" string="Transfer"
                                            invisible="review_status == 'removed' or decision != 'undecided'"
                                            groups="zvy_tendering.group_zvy_commission_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attendees" name="attendees">
                            <field name="attendee_ids"
                                   readonly="state in ('signed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="kind"/>
                                    <field name="user_id"
                                           invisible="kind != 'internal'"
                                           required="kind == 'internal'"
                                           options="{'no_create': True}"/>
                                    <field name="name" readonly="kind == 'internal'"/>
                                    <field name="role"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zvy_commission_meeting_search" model="ir.ui.view">
        <field name="name">zvy.commission.meeting.search</field>
        <field name="model">zvy.commission.meeting</field>
        <field name="arch" type="xml">
            <search string="Meetings">
                <field name="name"/>
                <field name="requesting_company_id"/>
                <filter string="Scheduled" name="scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="Held" name="held" domain="[('state', '=', 'held')]"/>
                <filter string="Signed" name="signed" domain="[('state', '=', 'signed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>

    <record id="action_zvy_commission_meeting" model="ir.actions.act_window">
        <field name="name">Meetings</field>
        <field name="res_model">zvy.commission.meeting</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zvy_commission_meeting_search"/>
    </record>
</odoo>
