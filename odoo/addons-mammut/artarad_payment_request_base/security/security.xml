<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_artarad_payment_request" model="ir.module.category">
            <field name="name">Payment Request</field>
        </record>

        <record id="group_artarad_payment_request_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_artarad_payment_request" />
        </record>

        <record id="group_artarad_payment_request_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_category_artarad_payment_request" />
            <field name="implied_ids"
                eval="[(4, ref('artarad_payment_request_base.group_artarad_payment_request_user'))]" />
        </record>

        <record id="group_artarad_payment_request_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_artarad_payment_request" />
            <field name="implied_ids"
                eval="[(4, ref('artarad_payment_request_base.group_artarad_payment_request_user'))]" />
        </record>

        <record id="group_artarad_payment_request_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="category_id" ref="module_category_artarad_payment_request" />
            <field name="implied_ids"
                eval="[(4, ref('artarad_payment_request_base.group_artarad_payment_request_user'))]" />
        </record>

        <record id="group_artarad_payment_request_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
            <field name="category_id" ref="module_category_artarad_payment_request" />
            <field name="implied_ids"
                eval="[(4, ref('artarad_payment_request_base.group_artarad_payment_request_approver')), (4, ref('artarad_payment_request_base.group_artarad_payment_request_manager')), (4, ref('artarad_payment_request_base.group_artarad_payment_request_officer'))]" />
        </record>

        <record id="rule_artarad_payment_request_user" model="ir.rule">
            <field name="name">Payment Request User: can see own records</field>
            <field name="model_id" ref="model_artarad_account_payment_request" />
            <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('recipient_id.user_ids', 'in', user.id), ('recipient_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('artarad_payment_request_base.group_artarad_payment_request_user'))]" />
            <field name="perm_unlink" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_read" eval="1" />
            <field name="perm_create" eval="1" />
        </record>

        <record id="rule_artarad_payment_request_officer" model="ir.rule">
            <field name="name">Payment Request Officer: can see own records</field>
            <field name="model_id" ref="model_artarad_account_payment_request" />
            <field name="domain_force">['|', '|', '|',('create_uid', '=', user.id), ('recipient_id.user_ids', 'in', user.id), ('recipient_id', '=', False),
                ('responsible_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('artarad_payment_request_base.group_artarad_payment_request_officer'))]" />
            <field name="perm_unlink" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_read" eval="1" />
            <field name="perm_create" eval="1" />
        </record>

         <record id="rule_artarad_payment_request_approver" model="ir.rule">
            <field name="name">Payment Request Approver: can see own records</field>
            <field name="model_id" ref="model_artarad_account_payment_request" />
            <field name="domain_force">['|', '|','|','|', ('create_uid', '=', user.id), ('recipient_id.user_ids', 'in', user.id), ('recipient_id', '=', False)
                ,('employee_id.payment_request_manager_id', '=', user.id), ('employee_id.payment_request_parent_ids.payment_request_manager_id', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('artarad_payment_request_base.group_artarad_payment_request_approver'))]" />
            <field name="perm_unlink" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_read" eval="1" />
            <field name="perm_create" eval="1" />
        </record>

        <record id="rule_artarad_payment_request_non_user" model="ir.rule">
            <field name="name">Payment Request Admin and Manager: can see all records</field>
            <field name="model_id" ref="model_artarad_account_payment_request" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('artarad_payment_request_base.group_artarad_payment_request_manager')), (4, ref('artarad_payment_request_base.group_artarad_payment_request_admin'))]" />
            <field name="perm_unlink" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_read" eval="1" />
            <field name="perm_create" eval="1" />
        </record>

        <record id="rule_artarad_payment_request_multi_company" model="ir.rule">
            <field name="name">Payment Request: multi company</field>
            <field name="model_id" ref="model_artarad_account_payment_request" />
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
            <field name="perm_unlink" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_read" eval="1" />
            <field name="perm_create" eval="1" />
        </record>

    </data>
</odoo>