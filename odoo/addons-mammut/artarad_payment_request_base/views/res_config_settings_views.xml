<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_form_res_config_settings_artarad_payment_request_base" model="ir.ui.view">
            <field name="name">view.form.res.config.settings.artarad.payment.request.base</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="75" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app name="artarad_payment_request_base" data-string="Payment Request" string="Payment Request">
                        <block title="Payment Request">
                            <setting help="Enable payment request for purchases">
                                <field name="module_artarad_payment_request_purchase" string="Purchase"/>
                            </setting>
                            <setting help="Enable payment request for payslips">
                                <field name="module_artarad_payment_request_payslip" string="Payslip"/>
                            </setting>
                            <setting help="Enable payment request for expenses">
                                <field name="module_artarad_payment_request_expense" string="Expense"/>
                            </setting>
                            <setting help="Enable payment request for bills">
                                <field name="module_artarad_payment_request_bill" string="Bill"/>
                            </setting>
                            <setting help="Enable payment request for purchase agreements">
                                <field name="module_artarad_payment_request_purchase_requisition" string="Purchase Agreement"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>