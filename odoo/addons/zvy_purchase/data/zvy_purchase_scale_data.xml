    <!-- ========== Minor — Operational ========== -->
    <record id="scale_minor_op_small" model="zvy.purchase.scale.rule">
        <field name="scale_id" ref="scale_minor"/>
        <field name="category">operational</field>
        <field name="tier">small</field>
        <field name="sequence">10</field>
        <field name="amount_max">1000000000</field>
        <field name="currency_id" ref="base.IRR"/>
        <field name="announcement">سه استعلام کتبی یا شفاهی مستند در فرم درخواست استعلام</field>
        <field name="advance_guarantee">معادل ۱۲۰٪ مبلغ پیش‌پرداخت (چک صیادی یا ضمانت‌نامه بانکی)</field>
        <field name="performance_guarantee">—</field>
        <field name="required_documents">پیش‌فاکتور و فاکتور رسمی، قرارداد یا تفاهم‌نامه، تأیید فنی واحد مصرف‌کننده در صورت نیاز</field>
    </record>
