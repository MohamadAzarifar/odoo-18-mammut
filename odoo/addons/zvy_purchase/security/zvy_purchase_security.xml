<odoo>
    <record id="module_category_zvy_purchase" model="ir.module.category">
        <field name="name">Purchase</field>
        <field name="description">Purchase requests, AVL, and product purchase attributes.</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_commission_manager" model="res.groups">
        <field name="name">Commission Manager</field>
        <field name="category_id" ref="module_category_zvy_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can change product purchase type and need-commission flags; read-only access to all purchase requests and commission cases across companies.</field>
    </record>

    <record id="group_commission_expert" model="res.groups">
        <field name="name">Commission Expert</field>
        <field name="category_id" ref="module_category_zvy_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can be assigned on commission cases; sees only assigned cases via the Commission menu.</field>
