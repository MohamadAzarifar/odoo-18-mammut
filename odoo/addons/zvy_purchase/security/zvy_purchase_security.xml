<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_zvy_purchase" model="ir.module.category">
        <field name="name">Purchase</field>
        <field name="description">Purchase requests, AVL, and product purchase attributes.</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_commission_manager" model="res.groups">
        <field name="name">Commission Manager</field>
        <field name="category_id" ref="module_category_zvy_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can change product purchase type and need-commission flags; read-only access to all purchase requests and commission cases across companies.</field>
    </record>

    <record id="group_commercial_expert" model="res.groups">
        <field name="name">Commercial Expert</field>
        <field name="category_id" ref="module_category_zvy_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can be assigned on purchase items as a commercial expert.</field>
    </record>

    <record id="group_planner" model="res.groups">
        <field name="name">Planner</field>
        <field name="category_id" ref="module_category_zvy_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create purchase requests and items; sees only own requests.</field>
    </record>

    <record id="group_commercial_manager" model="res.groups">
        <field name="name">Commercial Manager</field>
        <field name="category_id" ref="module_category_zvy_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create purchase requests and items; sees all requests in the company.</field>
    </record>

    <!-- Purchase Request visibility -->
    <record id="rule_zvy_purchase_request_planner" model="ir.rule">
        <field name="name">Purchase Request: Planner own</field>
        <field name="model_id" ref="model_zvy_purchase_request"/>
        <field name="domain_force">['&amp;', ('create_uid', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_planner'))]"/>
    </record>

    <record id="rule_zvy_purchase_request_commercial_manager" model="ir.rule">
        <field name="name">Purchase Request: Commercial Manager company</field>
        <field name="model_id" ref="model_zvy_purchase_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_commercial_manager'))]"/>
    </record>

    <record id="rule_zvy_purchase_request_commercial_expert" model="ir.rule">
        <field name="name">Purchase Request: Commercial Expert assigned item</field>
        <field name="model_id" ref="model_zvy_purchase_request"/>
        <field name="domain_force">[('item_ids.commercial_expert_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_commercial_expert'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_zvy_purchase_request_approval_approver" model="ir.rule">
        <field name="name">Purchase Request: Approval sequence approver</field>
        <field name="model_id" ref="model_zvy_purchase_request"/>
        <field name="domain_force">[('approval_request_ids.approver_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_zvy_purchase_request_commission_manager" model="ir.rule">
        <field name="name">Purchase Request: Commission Manager all companies</field>
        <field name="model_id" ref="model_zvy_purchase_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Holding-wide company read so Commission Manager can open PRs from any company -->
    <record id="rule_res_company_commission_manager" model="ir.rule">
        <field name="name">Company: Commission Manager all companies</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Purchase Item visibility -->
    <record id="rule_zvy_purchase_item_planner" model="ir.rule">
        <field name="name">Purchase Item: Planner own request</field>
        <field name="model_id" ref="model_zvy_purchase_item"/>
        <field name="domain_force">['&amp;', ('request_id.create_uid', '=', user.id), ('request_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_planner'))]"/>
    </record>

    <record id="rule_zvy_purchase_item_commercial_manager" model="ir.rule">
