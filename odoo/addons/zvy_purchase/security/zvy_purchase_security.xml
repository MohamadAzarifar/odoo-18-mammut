    <!-- Tender visibility -->
    <record id="rule_zvy_purchase_tender_commission_manager" model="ir.rule">
        <field name="name">Tender: Commission Manager all companies</field>
        <field name="model_id" ref="model_zvy_purchase_tender"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
    </record>

    <record id="rule_zvy_purchase_tender_commercial_manager" model="ir.rule">
        <field name="name">Tender: Commercial Manager company request</field>
        <field name="model_id" ref="model_zvy_purchase_tender"/>
