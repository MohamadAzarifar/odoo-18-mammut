    <!--
        Holding-wide: PR-linked approvals often live on a child company while
        Commission users keep only the parent selected in the company switcher.
        Soften Approvals multi-company rules so purchase-linked rows remain
        visible; group rules (owner/approver/commission) still apply.
        Use write() because the core rules are noupdate=1.
    -->
    <!--
        Holding-wide: PR-linked approvals often live on a child company while
        Commission users keep only the parent selected in the company switcher.
        Soften Approvals multi-company rules so purchase-linked rows remain
        visible; group rules (owner/approver/commission) still apply.
        Forced via write() because core rules are noupdate=1 (also in
        migrations/1.93/post-migrate.py).
    -->
    <function model="ir.rule" name="write">
        <value eval="[ref('approvals.approval_request_rule')]"/>
        <value eval="{'domain_force': '[\'|\', (\'company_id\', \'in\', company_ids), (\'zvy_purchase_request_id\', \'!=\', False)]'}"/>
    </function>
    <function model="ir.rule" name="write">
        <value eval="[ref('approvals.approval_product_line_rule')]"/>
        <value eval="{'domain_force': '[\'|\', (\'company_id\', \'in\', company_ids), (\'approval_request_id.zvy_purchase_request_id\', \'!=\', False)]'}"/>
    </function>
    <function model="ir.rule" name="write">
        <value eval="[ref('approvals.approval_approver_rule')]"/>
        <value eval="{'domain_force': '[\'|\', (\'company_id\', \'in\', company_ids), (\'request_id.zvy_purchase_request_id\', \'!=\', False)]'}"/>
    </function>

