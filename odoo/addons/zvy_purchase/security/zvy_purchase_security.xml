    <record id="rule_zvy_purchase_item_commercial_expert" model="ir.rule">
        <field name="name">Purchase Item: Commercial Expert assigned</field>
        <field name="model_id" ref="model_zvy_purchase_item"/>
        <field name="domain_force">[('commercial_expert_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_commercial_expert'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_zvy_purchase_item_approval_approver" model="ir.rule">
        <field name="name">Purchase Item: Approval sequence approver</field>
        <field name="model_id" ref="model_zvy_purchase_item"/>
        <field name="domain_force">[('request_id.approval_request_ids.approver_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_zvy_purchase_item_commission_manager" model="ir.rule">
        <field name="name">Purchase Item: Commission Manager all companies</field>
        <field name="model_id" ref="model_zvy_purchase_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Offer visibility -->
    <record id="rule_zvy_purchase_offer_planner" model="ir.rule">
        <field name="name">Offer: Planner own request</field>
        <field name="model_id" ref="model_zvy_purchase_offer"/>
        <field name="domain_force">['&amp;', ('item_id.request_id.create_uid', '=', user.id), ('item_id.request_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_planner'))]"/>
    </record>

    <record id="rule_zvy_purchase_offer_commercial_manager" model="ir.rule">
        <field name="name">Offer: Commercial Manager company request</field>
        <field name="model_id" ref="model_zvy_purchase_offer"/>
        <field name="domain_force">[('item_id.request_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_commercial_manager'))]"/>
    </record>

    <record id="rule_zvy_purchase_offer_commercial_expert" model="ir.rule">
        <field name="name">Offer: Commercial Expert assigned item</field>
        <field name="model_id" ref="model_zvy_purchase_offer"/>
        <field name="domain_force">[('item_id.commercial_expert_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_commercial_expert'))]"/>
    </record>

    <record id="rule_zvy_purchase_offer_approval_approver" model="ir.rule">
        <field name="name">Offer: Approval sequence approver</field>
        <field name="model_id" ref="model_zvy_purchase_offer"/>
        <field name="domain_force">[('item_id.request_id.approval_request_ids.approver_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_zvy_purchase_offer_commission_manager" model="ir.rule">
        <field name="name">Offer: Commission Manager all companies</field>
        <field name="model_id" ref="model_zvy_purchase_offer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Commission Case visibility -->
    <record id="rule_zvy_purchase_commission_case_commission_manager" model="ir.rule">
        <field name="name">Commission Case: Commission Manager all companies</field>
        <field name="model_id" ref="model_zvy_purchase_commission_case"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
    </record>

    <record id="rule_zvy_purchase_commission_case_commercial_manager" model="ir.rule">
        <field name="name">Commission Case: Commercial Manager company request</field>
        <field name="model_id" ref="model_zvy_purchase_commission_case"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_commercial_manager'))]"/>
    </record>

    <record id="rule_zvy_purchase_commission_case_planner" model="ir.rule">
        <field name="name">Commission Case: request creator</field>
        <field name="model_id" ref="model_zvy_purchase_commission_case"/>
        <field name="domain_force">['&amp;', ('request_id.create_uid', '=', user.id), ('request_id.company_id', 'in', company_ids)]</field>
