<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_commission_case_list" model="ir.ui.view">
        <field name="name">zvy.purchase.commission.case.list</field>
        <field name="model">zvy.purchase.commission.case</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="request_id"/>
                <field name="company_id"/>
                <field name="item_count" string="Items"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_purchase_commission_case_form" model="ir.ui.view">
        <field name="name">zvy.purchase.commission.case.form</field>
        <field name="model">zvy.purchase.commission.case</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button
                        name="action_assign_commission_experts"
                        string="Assign Experts"
                        type="object"
                        class="oe_highlight"
                        groups="zvy_purchase.group_commission_manager"
                        invisible="not can_assign_commission_experts"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_purchase_request"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not request_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Purchase Request</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="item_count" readonly="1"/>
                            <field name="can_assign_commission_experts" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purchase Items" name="purchase_items">
                            <field name="item_ids" readonly="1" create="0" delete="0">
                                <list create="0" delete="0" open_form_view="1">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="purchase_type_display"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Experts" name="experts">
                            <group>
                                <field name="can_assign_commission_experts" invisible="1"/>
                                <field
                                    name="commission_expert_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True}"
                                    readonly="not can_assign_commission_experts"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zvy_purchase_commission_case_search" model="ir.ui.view">
        <field name="name">zvy.purchase.commission.case.search</field>
        <field name="model">zvy.purchase.commission.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="request_id"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="action_zvy_purchase_commission_case" model="ir.actions.act_window">
        <field name="name">Commission</field>
        <field name="res_model">zvy.purchase.commission.case</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="view_zvy_purchase_commission_case_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No commission cases yet
            </p>
            <p>
                Commission cases are created from a Purchase Request via the Commission button.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_zvy_purchase_commission_case"
        name="Commission"
        parent="menu_zvy_purchase_root"
        action="action_zvy_purchase_commission_case"
        sequence="30"/>
    <record id="menu_zvy_purchase_commission_case" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_commission_manager'), ref('group_commission_expert')])]"/>
    </record>
</odoo>
