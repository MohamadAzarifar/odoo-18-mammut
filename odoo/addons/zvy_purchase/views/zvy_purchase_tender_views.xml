<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_tender_list" model="ir.ui.view">
        <field name="name">zvy.purchase.tender.list</field>
        <field name="model">zvy.purchase.tender</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="request_id"/>
                <field name="company_id"/>
                <field name="item_count" string="Items"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_purchase_tender_form" model="ir.ui.view">
        <field name="name">zvy.purchase.tender.form</field>
        <field name="model">zvy.purchase.tender</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_purchase_request"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not request_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Purchase Request</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="item_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purchase Items" name="purchase_items">
                            <field name="item_ids" readonly="1" create="0" delete="0">
                                <list create="0" delete="0" open_form_view="1">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="purchase_type_display"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state == 'in_review'" decoration-muted="state == 'tendering'" decoration-primary="state == 'selected'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zvy_purchase_tender_search" model="ir.ui.view">
        <field name="name">zvy.purchase.tender.search</field>
        <field name="model">zvy.purchase.tender</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="request_id"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="action_zvy_purchase_tender" model="ir.actions.act_window">
        <field name="name">Tenders</field>
        <field name="res_model">zvy.purchase.tender</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="view_zvy_purchase_tender_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tenders yet
            </p>
            <p>
                Tenders are created from a Purchase Request via the Tender button.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_zvy_purchase_tender"
        name="Tenders"
        parent="menu_zvy_purchase_root"
        action="action_zvy_purchase_tender"
        sequence="35"/>
    <record id="menu_zvy_purchase_tender" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_commission_manager')])]"/>
    </record>
</odoo>
