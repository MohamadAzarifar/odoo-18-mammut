<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_product_list" model="ir.ui.view">
        <field name="name">product.product.list.zvy.purchase</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Products" create="0" delete="0">
                <field name="name"/>
                <field name="default_code" optional="show"/>
                <field name="zvy_purchase_type"/>
                <field name="zvy_need_commission" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zvy_purchase_product_form" model="ir.ui.view">
        <field name="name">product.product.form.zvy.purchase</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form string="Product" create="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="default_code" readonly="1"/>
                        <field
                            name="zvy_purchase_type"
                            readonly="1"
                            groups="!zvy_purchase.group_commission_manager"/>
                        <field
                            name="zvy_purchase_type"
                            groups="zvy_purchase.group_commission_manager"/>
                        <field
                            name="zvy_need_commission"
                            invisible="zvy_purchase_type == 'tendering'"
                            readonly="1"
                            groups="!zvy_purchase.group_commission_manager"/>
                        <field
                            name="zvy_need_commission"
                            invisible="zvy_purchase_type == 'tendering'"
                            groups="zvy_purchase.group_commission_manager"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zvy_purchase_product_search" model="ir.ui.view">
        <field name="name">product.product.search.zvy.purchase</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="default_code"/>
            </search>
        </field>
    </record>

    <record id="view_product_product_form_zvy_purchase" model="ir.ui.view">
        <field name="name">product.product.form.inherit.zvy.purchase</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <page name="general_information" position="after">
                <page string="Purchase" name="zvy_purchase">
                    <group>
                        <group>
                            <field
                                name="zvy_purchase_type"
                                readonly="1"
                                groups="!zvy_purchase.group_commission_manager"/>
                            <field
                                name="zvy_purchase_type"
                                groups="zvy_purchase.group_commission_manager"/>
                            <field
                                name="zvy_need_commission"
                                invisible="zvy_purchase_type == 'tendering'"
                                readonly="1"
                                groups="!zvy_purchase.group_commission_manager"/>
                            <field
                                name="zvy_need_commission"
                                invisible="zvy_purchase_type == 'tendering'"
                                groups="zvy_purchase.group_commission_manager"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="view_product_product_list_zvy_purchase" model="ir.ui.view">
        <field name="name">product.product.list.inherit.zvy.purchase</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="zvy_purchase_type" optional="hide"/>
                <field name="zvy_need_commission" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="action_zvy_purchase_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zvy_purchase_product_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_zvy_purchase_product_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_zvy_purchase_product_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products found
            </p>
        </field>
    </record>

    <menuitem
        id="menu_zvy_purchase_product"
        name="Products"
        parent="menu_zvy_purchase_config"
        action="action_zvy_purchase_product"
        sequence="20"/>
</odoo>
