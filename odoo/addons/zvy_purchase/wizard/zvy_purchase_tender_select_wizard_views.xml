<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_tender_select_wizard_form" model="ir.ui.view">
        <field name="name">zvy.purchase.tender.select.wizard.form</field>
        <field name="model">zvy.purchase.tender.select.wizard</field>
        <field name="arch" type="xml">
            <form string="Select">
                <group>
                    <field name="tender_id"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" editable="bottom">
                        <field name="offer_id"/>
                        <field name="item_id"/>
                        <field name="vendor_id"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="final_price"/>
                        <field name="decision"/>
                        <field name="description"/>
                    </list>
                </field>
                <footer>
                    <button
                        name="action_confirm"
                        string="Select"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"/>
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
