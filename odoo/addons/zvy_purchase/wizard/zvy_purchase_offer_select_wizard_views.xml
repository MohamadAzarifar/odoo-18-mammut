<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_offer_select_wizard_form" model="ir.ui.view">
        <field name="name">zvy.purchase.offer.select.wizard.form</field>
        <field name="model">zvy.purchase.offer.select.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Offer">
                <group>
                    <field name="item_id" invisible="not item_id"/>
                </group>
                <field name="available_offer_ids" readonly="1" nolabel="1">
                    <list create="0" delete="0">
                        <field name="name"/>
                        <field name="item_id" optional="show"/>
                        <field name="vendor_id"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="unit_price"/>
                        <field name="quantity"/>
                        <field name="final_price"/>
                        <field name="state" widget="badge"/>
                    </list>
                </field>
                <group>
                    <field
                        name="selected_offer_id"
                        required="1"
                        options="{'no_create': True, 'no_create_edit': True}"
                        placeholder="Choose one validated offer"/>
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Next"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"/>
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
