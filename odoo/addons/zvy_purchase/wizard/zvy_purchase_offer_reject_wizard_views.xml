<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_offer_reject_wizard_form" model="ir.ui.view">
        <field name="name">zvy.purchase.offer.reject.wizard.form</field>
        <field name="model">zvy.purchase.offer.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Offer">
                <group>
                    <field name="offer_id"/>
                    <field name="reason" required="1" placeholder="Explain why this offer is rejected"/>
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Reject"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"/>
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
