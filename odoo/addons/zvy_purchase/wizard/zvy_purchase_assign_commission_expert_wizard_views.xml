<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_assign_commission_expert_wizard_form" model="ir.ui.view">
        <field name="name">zvy.purchase.assign.commission.expert.wizard.form</field>
        <field name="model">zvy.purchase.assign.commission.expert.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Experts">
                <group>
                    <field name="case_id"/>
                    <field
                        name="commission_expert_ids"
                        widget="many2many_tags"
                        options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button
                        name="action_assign"
                        string="Assign"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"/>
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
