<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_schedule_tender_wizard_form" model="ir.ui.view">
        <field name="name">zvy.purchase.schedule.tender.wizard.form</field>
        <field name="model">zvy.purchase.schedule.tender.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule">
                <group>
                    <field name="tender_id"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button
                        name="action_schedule"
                        string="Schedule"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"/>
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
