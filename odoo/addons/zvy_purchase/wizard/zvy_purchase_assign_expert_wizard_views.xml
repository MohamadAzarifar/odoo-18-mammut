<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zvy_purchase_assign_expert_wizard_form" model="ir.ui.view">
        <field name="name">zvy.purchase.assign.expert.wizard.form</field>
        <field name="model">zvy.purchase.assign.expert.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Expert">
                <group>
                    <field name="request_id"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="item_id" column_invisible="1"/>
                        <field name="item_name" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field
                            name="commercial_expert_ids"
                            widget="many2many_tags"
                            options="{'no_create': True, 'no_create_edit': True}"/>
                    </list>
                </field>
                <footer>
                    <button
                        name="action_assign"
                        string="Assign"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"/>
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
